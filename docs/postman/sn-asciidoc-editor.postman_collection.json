{
  "info": {
    "_postman_id": "b6f4c1d2-3a7e-4f8b-9c1d-5e2a7b0c9d41",
    "name": "sn-asciidoc-editor",
    "description": "Smoke checks for the published Standard Notes AsciiDoc editor and the external services it uses. The editor itself has no HTTP API; it communicates with the host over postMessage. See docs/platform-compatibility.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Distribution",
      "item": [
        {
          "name": "Published manifest",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('manifest identifies the editor', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.identifier).to.eql('dev.jtlimo.editor');",
                  "  pm.expect(body.area).to.eql('editor-editor');",
                  "  pm.expect(body.version).to.match(/^\\d+\\.\\d+\\.\\d+$/);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jtlimo.github.io/sn-asciidoc-editor/ext.json",
              "protocol": "https",
              "host": ["jtlimo", "github", "io"],
              "path": ["sn-asciidoc-editor", "ext.json"]
            }
          }
        },
        {
          "name": "Download bundle",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns a zip', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('zip'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jtlimo.github.io/sn-asciidoc-editor/latest.zip",
              "protocol": "https",
              "host": ["jtlimo", "github", "io"],
              "path": ["sn-asciidoc-editor", "latest.zip"]
            }
          }
        },
        {
          "name": "Demo page",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('contains the editor root', () => pm.expect(pm.response.text()).to.include('id=\"root\"'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jtlimo.github.io/sn-asciidoc-editor/demo.html",
              "protocol": "https",
              "host": ["jtlimo", "github", "io"],
              "path": ["sn-asciidoc-editor", "demo.html"]
            }
          }
        }
      ]
    },
    {
      "name": "External services",
      "item": [
        {
          "name": "Kroki diagram",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns an SVG', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('svg'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://kroki.io/graphviz/svg/eNpLyUwvSizIUHBXqPZIzcnJ17ULzy_KSanlAgB1EAjQ",
              "protocol": "https",
              "host": ["kroki", "io"],
              "path": ["graphviz", "svg", "eNpLyUwvSizIUHBXqPZIzcnJ17ULzy_KSanlAgB1EAjQ"]
            },
            "description": "Only called when Kroki is enabled in settings."
          }
        }
      ]
    }
  ]
}
